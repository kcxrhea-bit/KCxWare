<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\KCxWare.Core\KCxWare.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- WinExe: the helper must never show a console window after UAC elevation. It communicates
         results via its exit code and C:\ProgramData\KCxWare\logs\helper.log, not console I/O, so
         no output is lost by running without an attached console. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>..\..\assets\KCxWare.ico</ApplicationIcon>
    <AssemblyName>KCxWare.Helper</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
