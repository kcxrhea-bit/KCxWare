<Application x:Class="KCxWare.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KCxWare"
             xmlns:converters="clr-namespace:KCxWare.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <converters:InverseBooleanConverter x:Key="InverseBoolToBool" />
        <SolidColorBrush x:Key="Cyan" Color="#20E6FF" />
        <SolidColorBrush x:Key="Magenta" Color="#FF2BD6" />
        <SolidColorBrush x:Key="Panel" Color="#56070C13" />
        <LinearGradientBrush x:Key="NeonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#20E6FF" Offset="0" />
            <GradientStop Color="#A86DFF" Offset="0.5" />
            <GradientStop Color="#FF2BD6" Offset="1" />
        </LinearGradientBrush>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F5FAFF" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style x:Key="NeonButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#50070D15" />
            <Setter Property="BorderBrush" Value="{StaticResource NeonGradient}" />
            <Setter Property="BorderThickness" Value="1.25" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#78131D2C" />
                                <Setter TargetName="Frame" Property="Effect">
                                    <Setter.Value><DropShadowEffect Color="#8B63FF" BlurRadius="13" ShadowDepth="0" Opacity="0.58" /></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.76" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.46" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlassSurface" TargetType="Border">
            <Setter Property="Background" Value="#3D050B12" />
            <Setter Property="BorderBrush" Value="#7320E6FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect Color="#001018" BlurRadius="14" ShadowDepth="2" Opacity="0.55" /></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatusTile" TargetType="Border">
            <Setter Property="Background" Value="#5C070D16" />
            <Setter Property="BorderBrush" Value="#8020E6FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect Color="#20E6FF" BlurRadius="8" ShadowDepth="0" Opacity="0.18" /></Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
