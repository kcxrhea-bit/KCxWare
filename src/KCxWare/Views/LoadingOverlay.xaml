<UserControl x:Class="KCxWare.Views.LoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="False"
             d:DesignHeight="800" d:DesignWidth="1180">
    <UserControl.Resources>
        <Style x:Key="MilestoneLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Foreground" Value="#3A4B5C" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"
          AutomationProperties.LiveSetting="Assertive"
          AutomationProperties.Name="{Binding Status}">
        <Rectangle Fill="#DE01030A" IsHitTestVisible="True" />

        <Border Style="{StaticResource GlassSurface}" Background="#EC050A12"
                Width="660" MaxWidth="640" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="34,28">
            <Border.Effect>
                <DropShadowEffect Color="#20E6FF" BlurRadius="34" ShadowDepth="0" Opacity="0.32" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="K C x W A R E" FontSize="26" FontWeight="Black" HorizontalAlignment="Center">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#20E6FF" Offset="0" />
                            <GradientStop Color="#FF2BD6" Offset="1" />
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Cyan}"
                           HorizontalAlignment="Center" Margin="0,3,0,0" />

                <!-- Parade video -->
                <Border Margin="0,18,0,16" CornerRadius="14" Background="#7A05070C" BorderBrush="#5F20E6FF"
                        BorderThickness="1" Padding="2" ClipToBounds="True">
                    <Grid Height="220">
                        <MediaElement x:Name="ParadeVideo"
                                      LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                      Stretch="Uniform" StretchDirection="Both"
                                      IsHitTestVisible="False"
                                      Volume="0" ScrubbingEnabled="False"
                                      MediaEnded="ParadeVideo_OnMediaEnded" />
                    </Grid>
                </Border>

                <!-- Indeterminate activity ribbon -->
                <Grid Height="4" Margin="0,0,0,14" Visibility="{Binding IsIndeterminate, Converter={StaticResource BoolToVisibility}}">
                    <Rectangle Fill="#22FFFFFF" RadiusX="2" RadiusY="2" />
                    <Rectangle x:Name="IndeterminatePulse" Width="140" HorizontalAlignment="Left" RadiusX="2" RadiusY="2">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0020E6FF" Offset="0" />
                                <GradientStop Color="#FF20E6FF" Offset="0.5" />
                                <GradientStop Color="#00FF2BD6" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <!-- Determinate percentage -->
                <TextBlock Text="{Binding ProgressText}" FontSize="34" FontWeight="Black" HorizontalAlignment="Center"
                           Visibility="{Binding IsIndeterminate, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#20E6FF" Offset="0" />
                            <GradientStop Color="#FF2BD6" Offset="1" />
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>

                <TextBlock Text="{Binding Status}" Foreground="#C9D7E2" FontSize="13" HorizontalAlignment="Center"
                           Margin="0,4,0,18" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />

                <ProgressBar Height="6" Margin="0,0,0,14" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                             Visibility="{Binding IsIndeterminate, Converter={StaticResource InverseBoolToVisibility}}" />

                <!-- Milestone row: 20% cyan / 40% magenta / 60% cyan / 80% magenta / 100% combined -->
                <UniformGrid Columns="5" Margin="0,0,0,4">
                    <TextBlock x:Name="Milestone20Label" Text="20%" Style="{StaticResource MilestoneLabel}" />
                    <TextBlock x:Name="Milestone40Label" Text="40%" Style="{StaticResource MilestoneLabel}" />
                    <TextBlock x:Name="Milestone60Label" Text="60%" Style="{StaticResource MilestoneLabel}" />
                    <TextBlock x:Name="Milestone80Label" Text="80%" Style="{StaticResource MilestoneLabel}" />
                    <TextBlock x:Name="Milestone100Label" Text="100%" Style="{StaticResource MilestoneLabel}" />
                </UniformGrid>

                <!-- Completion state -->
                <StackPanel Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,18,0,0" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding CompletionHeadline}" FontSize="16" FontWeight="Black"
                               HorizontalAlignment="Center">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#20E6FF" Offset="0" />
                                <GradientStop Color="#FF2BD6" Offset="1" />
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FFFFFF" BlurRadius="16" ShadowDepth="0" Opacity="0.5" />
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <!-- Failure state -->
                <StackPanel Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,18,0,0">
                    <Border BorderBrush="{StaticResource Magenta}" BorderThickness="1" CornerRadius="10"
                            Background="#5C220B27" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="KCX · OPERATION FAILED" FontWeight="Bold" Foreground="{StaticResource Magenta}" />
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#E6D2E0" Margin="0,4,0,10"
                                       TextWrapping="Wrap" />
                            <Button Style="{StaticResource NeonButton}" Content="DISMISS" HorizontalAlignment="Left"
                                    Command="{Binding DismissCommand}" Padding="14,8" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
