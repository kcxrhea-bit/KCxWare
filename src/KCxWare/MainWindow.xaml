<Window x:Class="KCxWare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KCxWare"
        xmlns:views="clr-namespace:KCxWare.Views"
        mc:Ignorable="d"
        Title="KCxWare · PC Mode Control" Icon="Assets/KCxWare.ico"
        Width="1180" Height="800" MinWidth="960" MinHeight="680" WindowState="Maximized"
        WindowStartupLocation="CenterScreen" Background="#020305">
    <Grid Background="#020305">
        <Image Source="Assets/1.png" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <Rectangle Fill="#3D020508" IsHitTestVisible="False" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0.45" EndPoint="1,0.55">
                    <GradientStop Color="#2412CFEA" Offset="0" />
                    <GradientStop Color="#08000000" Offset="0.48" />
                    <GradientStop Color="#24E91FC6" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="K C x W A R E" FontSize="34" FontWeight="Black">
                        <TextBlock.Effect><DropShadowEffect Color="#20E6FF" BlurRadius="9" ShadowDepth="0" Opacity="0.34" /></TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="P C  M O D E  C O N T R O L" Foreground="{StaticResource Cyan}" FontSize="12" FontWeight="Bold" Margin="2,2,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#5C090D16" BorderBrush="{StaticResource Magenta}" BorderThickness="1"
                        CornerRadius="20" Padding="17,9" VerticalAlignment="Center">
                    <Border.Effect><DropShadowEffect Color="#FF2BD6" BlurRadius="12" ShadowDepth="0" Opacity="0.42" /></Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Cyan}" Margin="0,0,9,0" />
                        <TextBlock Text="{Binding Health}" FontWeight="Bold" FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>

            <TabControl Grid.Row="1" Margin="0,20,0,14" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="#C9D7E2" /><Setter Property="Background" Value="#48060C14" />
                        <Setter Property="BorderBrush" Value="#6920E6FF" /><Setter Property="Padding" Value="20,9" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="TabFrame" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                            CornerRadius="10,10,0,0" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#65111B29" /><Setter Property="Foreground" Value="White" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#061017" /><Setter Property="Background" Value="#C920E6FF" /><Setter Property="BorderBrush" Value="#E820E6FF" /></Trigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Resources>
                <TabItem Header="MODE CONTROL">
                    <Border Style="{StaticResource GlassSurface}" Background="#35050A11" Padding="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
                        <StackPanel Margin="28,24">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="C U R R E N T  M O D E" Foreground="#8FA9BC" FontSize="11" FontWeight="Bold" />
                                    <TextBlock Text="{Binding CurrentMode}" FontSize="29" FontWeight="Black" Margin="0,3,0,0">
                                        <TextBlock.Foreground><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#20E6FF" /><GradientStop Color="#FF2BD6" Offset="1" /></LinearGradientBrush></TextBlock.Foreground>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border Style="{StaticResource StatusTile}"><StackPanel><TextBlock Text="POWER PLAN" Foreground="#72DFF0" FontSize="9" /><TextBlock Text="{Binding ActivePowerPlan}" FontWeight="SemiBold" MaxWidth="250" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
                                    <Border Style="{StaticResource StatusTile}" BorderBrush="#80FF2BD6"><StackPanel><TextBlock Text="TRANSITION" Foreground="#F18BD9" FontSize="9" /><TextBlock Text="{Binding ArmedStatus}" FontWeight="SemiBold" /></StackPanel></Border>
                                </StackPanel>
                            </Grid>

                            <Border Visibility="{Binding ShowGamingExit, Converter={StaticResource BoolToVisibility}}" Margin="0,18,0,0" BorderBrush="{StaticResource Magenta}" BorderThickness="1" CornerRadius="12" Background="#69220B27" Padding="16">
                                <StackPanel><TextBlock Text="GAMING SESSION ACTIVE" FontWeight="Bold" Foreground="{StaticResource Magenta}" /><TextBlock Text="Return safely without leaving KCxWare running in the gaming session." Foreground="#C9D7E2" Margin="0,3,0,10" /><StackPanel Orientation="Horizontal"><Button Style="{StaticResource NeonButton}" Content="APPLY PROGRAMMING MODE" Click="ProgrammingClick" Margin="0,0,10,0" /><Button Style="{StaticResource NeonButton}" Content="APPLY NORMAL MODE" Click="NormalClick" /></StackPanel></StackPanel>
                            </Border>

                            <UniformGrid Columns="3" Margin="-8,20,-8,0">
                                <Button Style="{StaticResource NeonButton}" Click="GamingClick" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToBool}}" Margin="8" MinHeight="178" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" BorderBrush="#D620E6FF" Background="#4D06131B">
                                    <StackPanel><TextBlock Text="GAMING MODE" FontSize="17" FontWeight="Black" Foreground="{StaticResource Cyan}" /><TextBlock Text="LIVE SESSION ACTIVATION" FontSize="9" Foreground="#8EDCE6" Margin="0,3,0,15" /><TextBlock Text="Apply a temporary lean gaming environment now while preserving security, networking, audio, graphics, input, and anti-cheat." TextWrapping="Wrap" Foreground="#CBD8E3" LineHeight="19" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource NeonButton}" Click="ProgrammingClick" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToBool}}" Margin="8" MinHeight="178" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" BorderBrush="#D6A86DFF" Background="#4D100B1B">
                                    <StackPanel><TextBlock Text="PROGRAMMING MODE" FontSize="17" FontWeight="Black" Foreground="#BA8DFF" /><TextBlock Text="LIVE DEVELOPMENT ACTIVATION" FontSize="9" Foreground="#BFB0D8" Margin="0,3,0,15" /><TextBlock Text="Restore development, virtualization, local-AI, indexing, and sync capabilities now without auto-launching heavy tools." TextWrapping="Wrap" Foreground="#CBD8E3" LineHeight="19" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource NeonButton}" Click="NormalClick" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToBool}}" Margin="8" MinHeight="178" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" BorderBrush="#D6FF2BD6" Background="#4D190817">
                                    <StackPanel><TextBlock Text="NORMAL MODE" FontSize="17" FontWeight="Black" Foreground="{StaticResource Magenta}" /><TextBlock Text="EVERYDAY WINDOWS USE" FontSize="9" Foreground="#E79BD7" Margin="0,3,0,15" /><TextBlock Text="Balanced services, cloud sync, updates, RGB utilities, browsers, and everyday convenience features." TextWrapping="Wrap" Foreground="#CBD8E3" LineHeight="19" /></StackPanel>
                                </Button>
                            </UniformGrid>

                            <Border Style="{StaticResource GlassSurface}" Background="#4D06131B" BorderBrush="#8020E6FF" Padding="16" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="PING MONITOR" Foreground="{StaticResource Cyan}" FontWeight="Black" FontSize="15" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="Status: " Foreground="#D6E2EC" /><TextBlock Text="{Binding PingMonitorStatus}" Foreground="#D6E2EC" /></StackPanel>
                                        <CheckBox Content="Start KCxPingMonitor with Gaming Mode" IsChecked="{Binding StartPingMonitorWithGamingMode, Mode=TwoWay}" Foreground="#D6E2EC" Margin="0,10,0,0" />
                                        <CheckBox Content="Stop KCxPingMonitor when Gaming Mode ends" IsChecked="{Binding StopPingMonitorWhenGamingModeEnds, Mode=TwoWay}" Foreground="#D6E2EC" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource NeonButton}" Content="OPEN PING MONITOR" Click="OpenPingMonitorClick" Margin="6" />
                                        <Button Style="{StaticResource NeonButton}" Content="OPEN LOGS" Click="OpenPingLogsClick" Margin="6" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- CHAOS: a manual, purely cosmetic flavor-text button. Distinct from the automatic
                                 CompletionMessages system - pressing it never performs any real action. -->
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="ChaosButton" Style="{StaticResource NeonButton}" Content="CHAOS" Click="ChaosClick"
                                        Padding="16,9" FontSize="11" BorderBrush="{StaticResource Magenta}" />
                            </StackPanel>
                            <Border x:Name="ChaosPanel" Visibility="Collapsed" Margin="0,10,0,0" HorizontalAlignment="Left" MaxWidth="640"
                                    Style="{StaticResource GlassSurface}" Background="#4D0B0515" BorderBrush="{StaticResource Magenta}" Padding="14,11">
                                <TextBlock x:Name="ChaosText" TextWrapping="Wrap" FontStyle="Italic" FontSize="12" LineHeight="17" Foreground="#F5D6F2" />
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Visibility="{Binding ShowRecovery, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToBool}}" Style="{StaticResource NeonButton}" Content="RUN SAFE RECOVERY" Click="RecoverClick" Margin="0,0,10,0" />
                                <Button Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToBool}}" Style="{StaticResource NeonButton}" Content="CANCEL ARMED TRANSITION" Click="CancelClick" />
                            </StackPanel>
                            <TextBlock Text="{Binding ErrorDetail}" Foreground="#9DB0C0" Margin="2,12,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                    </Border>
                </TabItem>

                <TabItem Header="OFFLINE GUIDE">
                    <Border Style="{StaticResource GlassSurface}" Background="#78040910" Padding="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
                        <StackPanel Margin="30,24" MaxWidth="900">
                            <TextBlock Text="KCxWare Guide" FontSize="28" FontWeight="Black" Foreground="{StaticResource Cyan}" />
                            <TextBlock TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,18" Foreground="#D6E2EC" Text="KCxWare switches this PC between live Gaming, Programming, and Normal profiles. Each transition is transactional, elevated through Windows UAC, verified in the current session, and recorded under C:\ProgramData\KCxWare. Gaming and Programming end at the next Windows boot, which restores Normal." />
                            <TextBlock Text="MODES AND WHEN TO USE THEM" FontWeight="Bold" Foreground="{StaticResource Magenta}" />
                            <TextBlock TextWrapping="Wrap" LineHeight="21" Margin="0,7,0,16" Text="Gaming Mode has no fixed startup-settle delay. It performs a read-only capability and power-plan preflight, safely shuts down WSL only when available, and stops only running workloads on KCxWare's explicit development, sync, indexing, RGB, and background allowlists. Missing optional capabilities are normal and skipped. Services must reach STOPPED before remaining processes are terminated. Each apparently clean pass must remain clean for 35 seconds, covering WSearch's observed delayed restart action; a late restart triggers another cleanup attempt, and the three-attempt limit bounds the transition. Chrome, unlisted Chrome native hosts, graphics drivers, NVIDIA App/GeForce Experience Overlay, NVIDIA Highlights/recording, security, networking, audio, Logitech input, Gaming Services, and anti-cheat are protected. NVIDIA, AMD, and Intel graphics are supported without vendor-specific driver changes. Edge is suppressed only with no visible window; shared msedgewebview2 infrastructure is never killed indiscriminately. OpenRGB and RustDesk remain required cleanup targets. PhoneExperienceHost, CrossDeviceService, and CrossDeviceResume are logged best-effort targets; Windows DCOM-owned WidgetService is excluded from failure verification. A residual wslservice process is allowed only when WSLService, vmcompute, and vmmemWSL are stopped. WinFsp.Launcher is skipped when a running dependent service makes stopping it unsafe. Gaming selects the first installed KCx/Ryzen or Windows High Performance candidate and otherwise preserves the active plan. Programming restores captured services, recognizes Git/Git Bash, Node/npm, WSL, Docker, Ollama/local AI, .NET, Visual Studio, and VS Code when present, and never launches those tools. Normal restores the captured pre-Gaming plan when installed, otherwise an installed AMD Ryzen Balanced or Windows Balanced plan." />
                            <TextBlock Text="SETUP, DEFAULTS, AND PERMISSIONS" FontWeight="Bold" Foreground="{StaticResource Cyan}" />
                            <TextBlock TextWrapping="Wrap" LineHeight="21" Margin="0,7,0,16" Text="Install with installer\Install-KCxWare.ps1 or run the published folder. The UI stays unelevated. Choosing a mode confirms the live change, then Windows UAC elevates only KCxWare.Helper. Before mutation, KCxWare reads this PC's graphics vendor, common development tools, active power plan, supported installed plans, and relevant service state. Capability results are temporary and are not stored as a hardware/software inventory. Live transitions capture an immutable restoration baseline, apply policy, verify, and commit without requesting reboot. If the active plan cannot be captured, the transition stops before mutation. A boot/session marker detects a later Windows boot and restores Normal through the helper. Legacy Apply Armed Mode tasks are normalized safely. Default state is Normal; unknown or missing optional services/tools are ignored. No secrets are stored. State and transaction recovery data are stored in ProgramData; helper logs contain operation names and errors only." />
                            <TextBlock Text="APPEARANCE AND READABILITY" FontWeight="Bold" Foreground="{StaticResource Magenta}" />
                            <TextBlock TextWrapping="Wrap" LineHeight="21" Margin="0,7,0,16" Text="KCxWare loads its packaged Assets\1.png artwork locally and places translucent glass controls above it; no network access or extra permission is required. The full artwork is centered without changing its aspect ratio, while localized dark surfaces preserve readable status and Guide text. Resize the window normally when you need more room. If the artwork is missing or the background is plain black, repair or reinstall KCxWare and confirm Assets\1.png exists beside the installed application; do not substitute an online or absolute-path image." />
                            <TextBlock Text="RISKS AND RECOVERY" FontWeight="Bold" Foreground="{StaticResource Magenta}" />
                            <TextBlock TextWrapping="Wrap" LineHeight="21" Margin="0,7,0,16" Text="A live mode transition does not restart Windows, but Gaming suppression can close allowlisted applications, including an already-open Snipping Tool, OpenRGB, RustDesk, or Salad; save their work first. PhoneExperienceHost, CrossDeviceService, CrossDeviceResume, and DCOM-owned WidgetService may remain or respawn and are not cleanup failures; the helper log identifies best-effort survivors. KCxWare waits for service shutdown and temporarily suppresses only the verified WSearch recovery behavior; it does not change service startup types, startup tasks, COM registrations, drivers, or security settings. Normal and recovery restart only services captured as running before Gaming and restore the captured installed power plan; they do not relaunch arbitrary applications because their original command lines and session state cannot be reconstructed safely. Protected Chrome and recording components are left running. If UAC is declined, the helper is missing, baseline capture fails, a service cannot stop safely, sustained verification finds a required workload after three attempts, or a transition is interrupted, reopen KCxWare. Use Cancel Armed Transition for a stale legacy task, or Run Safe Recovery when RECOVERY REQUIRED appears. Recovery restores recorded service and WSearch recovery state, restores the prior installed power plan when possible, and removes the one-shot scheduled task." />
                            <TextBlock Text="PING MONITOR COMPANION" FontWeight="Bold" Foreground="{StaticResource Cyan}" />
                            <TextBlock TextWrapping="Wrap" LineHeight="21" Margin="0,7,0,16" Text="KCxWare can manage the standalone KCxPingMonitor companion without merging its source or taking ownership of its logs. The panel reports Running, Stopped, or Not Found; Open Ping Monitor launches one copy or brings the existing window forward, and Open Logs opens %LOCALAPPDATA%\\KCxPingMonitor\\logs. The optional Start KCxPingMonitor with Gaming Mode setting is OFF by default. Stop KCxPingMonitor when Gaming Mode ends is also OFF by default so an existing diagnostic session is not lost. KCxWare searches only the packaged Tools\\KCxPingMonitor location, the per-user companion location, and the known development fallback; it does not scan the disk. No live metrics are scraped or displayed, and no localhost server or automatic network change is used. If the companion is unavailable, install the packaged companion or repair the KCxWare package; Gaming Mode otherwise continues without it." />
                            <TextBlock Text="EXAMPLES AND RELATED FEATURES" FontWeight="Bold" Foreground="{StaticResource Cyan}" />
                            <TextBlock TextWrapping="Wrap" LineHeight="21" Margin="0,7,0,16" Text="Before Fortnite: save work, choose Gaming Mode, approve the confirmation and UAC, and allow the inline cleanup plus sustained verification window to finish. Keep Chrome or recording/overlay features open when needed; they are protected. Gaming succeeds only after the clean state remains stable, and the helper log lists detected capabilities and any survivors. After gaming, choose Programming Mode or Normal Mode. Programming restores captured services and detects available developer tooling without launching it. Normal restores the captured service and power-plan baseline and intentionally leaves closed applications for you to relaunch. Check Current Mode, Power Plan, Transition, reboot status, last transition, and health before acting. KCxWare does not remain resident." />
                            <TextBlock Text="TROUBLESHOOTING" FontWeight="Bold" Foreground="{StaticResource Magenta}" />
                            <TextBlock TextWrapping="Wrap" LineHeight="21" Margin="0,7,0,0" Text="Missing helper: repair or reinstall the published KCxWare folder. UAC declined: no system transition is made; choose the mode again. Missing optional service, tool, GPU vendor, WSL/Docker installation, or preferred power plan: expected and safely skipped; if no preferred candidate exists, KCxWare preserves the active plan. Baseline power-plan capture failure: KCxWare stops before mutation; verify powercfg works and retry. Service stop timeout: close the service's owning application, run recovery, and retry; do not disable the service permanently. WinFsp safety skip: close or identify its dependent application rather than forcing the service down. OpenRGB or RustDesk survivor: inspect the initial and sustained checks in C:\ProgramData\KCxWare\logs\helper.log, close only its current session owner, then run recovery before retrying Gaming Mode. WSearch restart: KCxWare watches beyond its observed delayed restart and retries within the three-attempt limit; a persistent survivor still requires recovery. Phone or Cross Device best-effort survivor: Windows reactivated a registered startup or COM host; this is logged without disabling Windows activation settings. DCOM-owned WidgetService may also remain. WSL failure: a lone wslservice process is acceptable only when WSLService, vmcompute, and vmmemWSL are stopped; otherwise close WSL clients and recover. Chrome, graphics drivers, or recording/overlay components must not be treated as survivors; if named, repair or update KCxWare rather than killing them. Stale armed task: cancel it in KCxWare or run recovery. Persistent problems: inspect C:\ProgramData\KCxWare\state.json and logs\helper.log without deleting them, then use the installer repair path." />
                        </StackPanel>
                    </ScrollViewer>
                    </Border>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Style="{StaticResource GlassSurface}" Background="#48050A11" CornerRadius="11" Padding="14,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Foreground="#71DDEB" FontSize="10"><Run Text="LAST TRANSITION  ·  " /><Run Text="{Binding LastTransition, Mode=OneWay}" Foreground="#E3EDF5" /></TextBlock>
                    <TextBlock Foreground="#71DDEB" FontSize="10" Margin="0,2,0,0"><Run Text="REBOOT  ·  " /><Run Text="{Binding RebootStatus, Mode=OneWay}" Foreground="{StaticResource Magenta}" /></TextBlock>
                </StackPanel>

                <!-- POWER: Restart/Shut Down Windows. These are power controls, not modes; both
                     require confirmation and are disabled whenever another KCxWare operation is active. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="P O W E R" Foreground="#8FA9BC" FontSize="9" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource NeonButton}" Content="RESTART WINDOWS" Click="RestartWindowsClick"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToBool}}"
                            Padding="14,8" FontSize="11" Margin="0,0,8,0" BorderBrush="{StaticResource Cyan}" />
                    <Button Style="{StaticResource NeonButton}" Content="SHUT DOWN WINDOWS" Click="ShutdownWindowsClick"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToBool}}"
                            Padding="14,8" FontSize="11" BorderBrush="{StaticResource Magenta}" />
                </StackPanel>
            </Grid>
            </Border>
        </Grid>

        <views:LoadingOverlay x:Name="LoadingHost" />
    </Grid>
</Window>
